# Copy these names into your local environment; never commit actual secrets.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gradcafe
DB_USER=gradcafe_app
DB_PASSWORD=replace-with-a-strong-local-secret

# Optional alternative used by integration tests and hosted deployments:
# DATABASE_URL=postgresql+psycopg://gradcafe_app:secret@localhost:5432/gradcafe
